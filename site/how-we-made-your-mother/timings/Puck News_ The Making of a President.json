["a",45500,240],["quickie",45740,440],["interview",46180,480],["like",46660,320],["you",46980,140],["get",47120,140],["on",47260,140],["most",47400,260],["news",47660,260],["shows.",47920,380]]},{"start":48300,"end":50220,"speaker":null,"text":"This is a true deep dive.","words":[["This",48300,500],["is",48800,120],["a",48920,140],["true",49060,360],["deep",49420,420],["dive.",49840,380]]},{"start":50380,"end":54140,"speaker":null,"text":"But whether you're a political junkie or just love any high-stakes human drama,","words":[["But",50380,80],["whether",50460,240],["you're",50700,220],["a",50920,120],["political",51040,260],["junkie",51300,560],["or",51860,320],["just",52180,220],["love",52400,220],["any",52620,300],["high-stakes",52920,560],["human",53480,260],["drama,",53740,400]]},{"start":54140,"end":59860,"speaker":null,"text":"The Making of a President offers an incredible look at how power is actually won.","words":[["The",54140,580],["Making",54720,340],["of",55060,340],["a",55400,140],["President",55540,380],["offers",55920,720],["an",56640,220],["incredible",56860,500],["look",57360,380],["at",57740,400],["how",58140,160],["power",58300,400],["is",58700,240],["actually",58940,500],["won.",59440,420]]},{"start":60260,"end":62840,"speaker":null,"text":"Here now is a quick preview of episode one.","words":[["Here",60260,280],["now",60540,220],["is",60760,180],["a",60940,140],["quick",61080,240],["preview",61320,420],["of",61740,240],["episode",61980,420],["one.",62400,440]]},{"start":63240,"end":68040,"speaker":null,"text":"Make sure to search The Making of a President wherever you listen and subscribe today.","words":[["Make",63240,560],["sure",63800,140],["to",63940,160],["search",64100,340],["The",64440,420],["Making",64860,340],["of",65200,320],["a",65520,140],["President",65660,340],["wherever",66000,300],["you",66300,180],["listen",66480,360],["and",66840,420],["subscribe",67260,380],["today.",67640,400]]},{"start":68280,"end":71300,"speaker":null,"tex