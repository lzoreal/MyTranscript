0,140],["not.",93870,240]]},{"start":94570,"end":96790,"speaker":null,"text":"We are in a midterm election right now, I know,","words":[["We",94570,480],["are",95050,140],["in",95190,100],["a",95290,60],["midterm",95350,300],["election",95650,320],["right",95970,220],["now,",96190,180],["I",96510,60],["know,",96570,220]]},{"start":96890,"end":101070,"speaker":null,"text":"but the presidential campaign jockeying is already underway behind the scenes,","words":[["but",96890,120],["the",97010,120],["presidential",97130,480],["campaign",97610,580],["jockeying",98190,620],["is",98810,260],["already",99070,640],["underway",99710,460],["behind",100170,380],["the",100550,200],["scenes,",100750,320]]},{"start":101070,"end":105310,"speaker":null,"text":"and it will kick off for real immediately after the midterms conclude in November.","words":[["and",101070,200],["it",101270,80],["will",101350,100],["kick",101450,240],["off",101690,200],["for",101890,220],["real",102110,380],["immediately",102490,560],["after",103050,640],["the",103690,160],["midterms",103850,460],["conclude",104310,440],["in",104750,200],["November.",104950,360]]},{"start":105950,"end":110470,"speaker":null,"text":"I want this show to be about how politics and campaigns really work.","words":[["I",105950,320],["want",106270,280],["this",106550,200],["show",106750,260],["to",107010,260],["be",107270,160],["about",107430,280],["how",107710,180],["politics",107890,540],["and",108430,340],["campaigns",108770,680],["really",109450,520],["work.",109970,500]]},{"start":110830,"end":114850,"speaker":null,"text":"As much as I'm a political junkie, and this will be my sixth presidential campaign,","words":[["As",110830,560],["much",111390,180],["as",111570,120],["I'm",111690,140],["a",111830,80],["political",111910,280],["junkie,",112190,400],["and",112670,180],["this",112850,140],["will",112990,100],["be",113090,100],["my",113190,180],["sixth",113370,540],["presidential",113910,500],["campaign,",114410,440]]},{"start":115110,"end":119570,"speaker":null,"text":"it's long been a gripe of mine that political journalism is kind of a cocoon.","words":[["it's",115110,460],["long",115570,400],["been",115970,340],["a",116310,140],["gripe",116450,300],["of",116750,120],["mine",116870,200],["that",117070,160],["political",117230,420],["journalism",117650,500],["is",118150,340],["kind",118490,360],["of",118850,160],["a",119010,100],["cocoon.",119110,460]]},{"start":119650,"end":123310,"speaker":null,"text":"A bunch of operatives and journalists talking to each other without pausing","words":[["A",119650,460],["bunch",120110,180],["of",120290,140],["operatives",120430,520],["and",120950,160],["journalists",121110,380],["talking",121490,360],["to",121850,200],["each",122050,200],["other",122250,240],["without",122490,240],["pausing",122730,580]]},{"start":123310,"end":127230,"speaker":null,"text":"to explain to viewers and voters what exactly they're talking about.","words":[["to",123310,260],["explain",123570,380],["to",123950,160],["viewers",124110,380],["and",124490,220],["voters",124710,320],["what",125030,660],["exactly",125690,600],["they're",126290,360],["talking",126650,300],["about.",126950,280]]},{"start":127910,"end":131590,"speaker":null,"text":"Our conversations on this podcast are going to be smart and elevated,","words":[["Our",127910,260],["conversations",128170,540],["on",128710,240],["this",128950,120],["podcast",129070,340],["are",129410,320],["going",129730,320],["to",130050,240],["be",130290,180],["smart",130470,440],["and",130910,260],["elevated,",131170,420]]},{"start":131630,"end":135210,"speaker":null,"text":"but we're going to focus on the business of presidential campaigns.","words":[["but",131630,280],["we're",131910,160],["going",132070,120],["to",132190,180],["focus",132370,400],["on",132770,360],["the",133130,180],["business",133310,440],["of",133750,440],["presidential",134190,420],["campaigns.",134610,600]]},{"start":135310,"end":137650,"speaker":null,"text":"And the gears that move them from the inside.","words":[["And",135310,420],["the",135730,140],["gears",135870,300],["that",136170,180],["move",136350,280],["them",136630,180],["from",136810,280],["the",137090,160],["inside.",137250,400]]},{"start":137930,"end":140210,"speaker":null,"text":"How messages and memes get pushed out.","words":[["How",137930,380],["messages",138310,460],["and",138770,300],["memes",139070,380],["get",139450,240],["pushed",139690,260],["out.",139950,260]]},{"start":140430,"end":141330,"speaker":null,"text":"How the money works.","words":[["How",140430,200],["the",140630,120],["money",140750,260],["works.",141010,320]]},{"start":141530,"end":143630,"speaker":null,"text":"How do you win a specific primary state?","words":[["How",141530,280],["do",141810,120],["you",141930,100],["win",142030,280],["a",142310,160],["specific",142470,380],["primary",142850,460],["state?",143310,320]]},{"start":143850,"end":146390,"speaker":null,"text":"Why does that state matter more than another state?","words":[["Why",143850,320],["does",144170,180],["that",144350,220],["state",144570,320],["matter",144890,320],["more",145210,280],["than",145490,340],["another",145830,260],["state?",146090,300]]},{"start":146650,"end":148250,"speaker":null,"text":"Does polling even work anymore?","words":[["Does",146650,400],["polling",147050,360],["even",147410,300],["work",147710,280],["anymore?",147990,260]]},{"start":148930,"end":153910,"speaker":null,"text":"This won't be a show reacting to every micro news cycle or Trump headline.","words":[["This",148930,560],["won't",149490,420],["be",149910,140],["a",150050,120],["show",150170,320],["reacting",150490,620],["to",151110,260],["every",151370,400],["micro",151770,460],["news",152230,320],["cycle",152550,380],["or",152930,260],["Trump",153190,320],["headline.",153510,400]]},{"start":154090,"end":156190,"speaker":null,"text":"There are too many options out there on that front.","words":[["There",154090,120],["are",154210,100],["too",154310,260],["many",154570,280],["options",154850,380],["out",155230,200],["there",155430,200],["on",155630,160],["that",155790,180],["front.",155970,220]]},{"start":156450,"end":159370,"speaker":null,"text":"We'll obviously talk about the news and issues and big names.","words":[["We'll",156450,340],["obviously",156790,380],["talk",157170,300],["about",157470,220],["the",157690,140],["news",157830,280],["and",158110,180],["issues",158290,300],["and",158590,220],["big",158810,200],["names.",159010,360]]},{"start":159570,"end":161890,"speaker":null,"text":"Those things define the rhythms of any campaign.","words":[["Those",159570,140],["things",159710,180],["define",159890,420],["the",160310,220],["rhythms",160530,300],["of",160830,260],["any",161090,340],["campaign.",161430,460]]},{"start":161890,"end":164450,"speaker":null,"text":"But we won't live and die by the news cycle.","words":[["But",161890,560],["we",162450,140],["won't",162590,420],["live",163010,240],["and",163250,100],["die",163350,260],["by",163610,220],["the",163830,140],["news",163970,180],["cycle.",164150,300]]},{"start":164750,"end":168410,"speaker":null,"text":"Instead, I want to bring you conversations with the players who call the shots.","words":[["Instead,",164750,480],["I",165470,20],["want",165490,100],["to",165590,60],["bring",165650,120],["you",165770,120],["conversations",165890,640],["with",166530,320],["the",166850,140],["players",166990,460],["who",167450,220],["call",167670,200],["the",167870,160],["shots.",168030,380]]},{"start":168630,"end":172930,"speaker":null,"text":"People who can explain trends in media and technology and demographics.","words":[["People",168630,460],["who",169090,200],["can",169290,160],["explain",169450,600],["trends",170050,540],["in",170590,200],["media",170790,340],["and",171130,280],["technology",171410,580],["and",171990,320],["demographics.",172310,620]]},{"start":173370,"end":178490,"speaker":null,"text":"And the campaign operatives who are grappling with the fact that the rules of modern campaigning,","words":[["And",173370,200],["the",173570,120],["campaign",173690,560],["operatives",174250,660],["who",174910,220],["are",175130,80],["grappling",175210,440],["with",175650,260],["the",175910,140],["fact",176050,240],["that",176290,320],["the",176610,140],["rules",176750,460],["of",177210,260],["modern",177470,380],["campaigning,",177850,640]]},{"start":178670,"end":182390,"speaker":null,"text":"we all thought we knew, are being broken and rewritten in real time.","words":[["we",178670,260],["all",178930,240],["thought",179170,200],["we",179370,180],["knew,",179550,200],["are",180030,200],["being",180230,180],["broken",180410,400],["and",180810,340],["rewritten",181150,360],["in",181510,380],["real",181890,240],["time.",182130,260]]},{"start":182390,"end":189890,"speaker":null,"text":"The 2028 campaign will be the most unpredictable, unmediated, and wide-open presidential race we've ever seen.","words":[["The",182390,700],["2028",183090,600],["campaign",183690,320],["will",184010,380],["be",184390,180],["the",184570,280],["most",184850,380],["unpredictable,",185230,700],["unmediated,",186370,720],["and",187250,80],["wide-open",187330,760],["presidential",188090,500],["race",188590,400],["we've",188990,340],["ever",189330,280],["seen.",189610,280]]},{"start":190150,"end":192530,"speaker":null,"text":"We're going to talk to Republicans and Democrats.","words":[["We're",190150,480],["going",190630,80],["to",190710,80],["talk",190790,160],["to",190950,120],["Republicans",191070,480],["and",191550,560],["Democrats.",192110,420]]},{"start":192530,"end":196470,"speaker":null,"text":"And while we have a likely 2028 contender on the show today,","words":[["And",192530,460],["while",192990,280],["we",193270,200],["have",193470,220],["a",193690,200],["likely",193890,420],["2028",194310,800],["contender",195110,560],["on",195670,240],["the",195910,100],["show",196010,180],["today,",196190,280]]},{"start":196850,"e