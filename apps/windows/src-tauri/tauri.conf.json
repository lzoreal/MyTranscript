{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyTranscript",
  "version": "0.1.0",
  "identifier": "com.myt.transcript.desktop",
  "build": {
    "frontendDist": "../../../site"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MyTranscript",
        "x": 60, "y": 40, "width": 1180,
        "height": 880,
        "minWidth": 720,
        "minHeight": 540,
        "url": "player.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["vendor/sherpa/lib/sherpa-onnx-c-api.dll", "vendor/sherpa/lib/onnxruntime.dll", "vendor/sherpa/lib/onnxruntime_providers_shared.dll"]
  }
}
