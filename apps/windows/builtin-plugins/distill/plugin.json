{
  "id": "distill",
  "name": "随手摘录",
  "version": "0.1.0",
  "description": "听到就摘：把当前句前后一小段收进摘录本，可回跳、可导出；本机单集还能顺手裁一段音频。",
  "author": "MyTranscript",
  "enabled": true,
  "apiVersion": "2.2",
  "requires": { "subtitles": "^0.3.0" },
  "permissions": ["ui.dom", "storage", "player", "media"],
  "contributions": {
    "pages": [{ "id": "distill", "title": "摘录本", "subtitle": "随手摘录插件 · 听的时候记，回来能跳" }],
    "slots": [
      { "id": "distill-dock", "slot": "player.dock.actions", "order": 10 },
      { "id": "distill-episode", "slot": "episode.body.before", "order": 10 }
    ]
  },
  "main": "main.js",
  "style": "style.css"
}
